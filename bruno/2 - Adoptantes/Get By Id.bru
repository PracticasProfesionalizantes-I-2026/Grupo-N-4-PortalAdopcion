meta {
  name: Get By Id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/adoptantes/{{adoptanteId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  const res = bru.getResBody();
  const status = res.getStatus();
  const body = res.getBody();

  test("Código de estado 200", () => {
    expect(status).to.equal(200);
  });

  test("Devuelve el adoptante del id solicitado", () => {
    expect(body).to.have.property("id").that.equals(bru.getEnvVar("adoptanteId"));
  });

  test("Shape completo de AdoptanteResponseDTO", () => {
    expect(body).to.have.property("nombreCompleto").that.is.a("string");
    expect(body).to.have.property("email").that.is.a("string");
    expect(body).to.have.property("dni").that.is.a("string");
    expect(body).to.have.property("telefono").that.is.a("string");
    expect(body).to.have.property("direccion").that.is.a("string");
    expect(body).to.have.property("fechaRegistro");
  });
}