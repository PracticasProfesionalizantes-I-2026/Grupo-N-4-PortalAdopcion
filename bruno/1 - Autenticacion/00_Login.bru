meta {
  name: 00 Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@demo.local",
    "password": "DemoPortal2026!"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
  bru.setVar("usuarioId", res.body.usuario.id);
}

tests {
  test("200 - credenciales válidas", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve un token JWT", function() {
    expect(res.body.token).to.be.a("string");
    expect(res.body.token.length).to.be.above(20);
  });
  test("la sesión corresponde al Administrador", function() {
    expect(res.body.usuario.rol).to.equal("Administrador");
  });
}

