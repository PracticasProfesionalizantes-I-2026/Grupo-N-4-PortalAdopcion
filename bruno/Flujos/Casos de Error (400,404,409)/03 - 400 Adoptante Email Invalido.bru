meta {
  name: 03 - 400 Adoptante Email Invalido
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/adoptantes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombreCompleto": "Rosa Diaz",
    "email": "malformado",
    "dni": "40123456",
    "telefono": "1145678901",
    "direccion": "Calle 1"
  }
}

tests {
  const res = bru.getResBody();
  const status = res.getStatus();
  const body = res.getBody();

  test("Código de estado 400 Bad Request", () => {
    expect(status).to.equal(400);
  });

  test("El body de error tiene un mensaje", () => {
    expect(body).to.have.property("message").that.is.a("string");
    expect(body.message.length).to.be.greaterThan(0);
  });
}