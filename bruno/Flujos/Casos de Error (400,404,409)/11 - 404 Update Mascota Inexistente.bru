meta {
  name: 11 - 404 Update Mascota Inexistente
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/mascotas/{{guidInexistente}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Fantasma",
    "especie": "Gato",
    "raza": "Mestizo",
    "edad": 2,
    "sexo": "Macho",
    "estado": "Disponible"
  }
}

tests {
  const res = bru.getResBody();
  const status = res.getStatus();
  const body = res.getBody();

  test("Código de estado 404 Not Found", () => {
    expect(status).to.equal(404);
  });

  test("El body de error tiene un mensaje", () => {
    expect(body).to.have.property("message").that.is.a("string");
    expect(body.message.length).to.be.greaterThan(0);
  });
}