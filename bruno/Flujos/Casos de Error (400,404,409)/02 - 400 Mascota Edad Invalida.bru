meta {
  name: 02 - 400 Mascota Edad Invalida
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/mascotas
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Tweak",
    "especie": "Perro",
    "raza": "Bulldog",
    "edad": 35,
    "sexo": "Macho"
  }
}

tests {
  const res = bru.getResBody();
  const status = res.getStatus();
  const body = res.getBody();

  test("Código de estado 400 Bad Request", () => {
    expect(status).to.equal(400);
  });

  test("El body de error tiene un mensaje", () => {
    expect(body).to.have.property("message").that.is.a("string");
    expect(body.message.length).to.be.greaterThan(0);
  });
}