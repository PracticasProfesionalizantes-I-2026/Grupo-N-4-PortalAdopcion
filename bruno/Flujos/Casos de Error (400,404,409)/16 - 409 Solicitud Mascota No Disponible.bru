meta {
  name: 16 - 409 Solicitud Mascota No Disponible
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/solicitudes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mascotaId": "{{mascotaTomId}}",
    "adoptanteId": "{{adoptanteJuanId}}"
  }
}

tests {
  const res = bru.getResBody();
  const status = res.getStatus();
  const body = res.getBody();

  test("Código de estado 409 Conflict", () => {
    expect(status).to.equal(409);
  });

  test("El body de error tiene un mensaje", () => {
    expect(body).to.have.property("message").that.is.a("string");
    expect(body.message.length).to.be.greaterThan(0);
  });
}