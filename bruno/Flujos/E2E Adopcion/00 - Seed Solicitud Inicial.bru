meta {
  name: 00 - Seed Solicitud Inicial (Tom + Ana)
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/solicitudes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mascotaId": "{{mascotaTomId}}",
    "adoptanteId": "{{adoptanteAnaId}}"
  }
}

tests {
  const res = bru.getResBody();
  const status = res.getStatus();
  const body = res.getBody();

  test("Código de estado 201 Created", () => {
    expect(status).to.equal(201);
  });

  test("La solicitud seed nace Pendiente", () => {
    expect(body).to.have.property("estado").that.equals("Pendiente");
  });

  bru.setEnvVar("solicitudId", body.id);
}