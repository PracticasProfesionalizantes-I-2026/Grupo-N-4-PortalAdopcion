meta {
  name: 11 - Cancelar Solicitud
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/solicitudes/{{solicitudId}}?motivo=Desistimiento%20del%20adoptante
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  const res = bru.getResBody();
  const status = res.getStatus();

  test("Código de estado 204 No Content", () => {
    expect(status).to.equal(204);
  });
}