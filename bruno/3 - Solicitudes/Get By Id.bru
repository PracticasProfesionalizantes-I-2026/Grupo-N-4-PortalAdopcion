meta {
  name: Get By Id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/solicitudes/{{solicitudId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  const res = bru.getResBody();
  const status = res.getStatus();
  const body = res.getBody();

  test("Código de estado 200", () => {
    expect(status).to.equal(200);
  });

  test("Devuelve la solicitud del id solicitado", () => {
    expect(body).to.have.property("id").that.equals(bru.getEnvVar("solicitudId"));
  });

  test("Shape completo de SolicitudResponseDTO", () => {
    expect(body).to.have.property("mascotaId").that.is.a("string");
    expect(body).to.have.property("adoptanteId").that.is.a("string");
    expect(body).to.have.property("fechaSolicitud");
    expect(body).to.have.property("estado").that.is.oneOf(["Pendiente", "Aprobada", "Rechazada", "Cancelada"]);
    expect(body).to.have.property("motivo");
  });
}