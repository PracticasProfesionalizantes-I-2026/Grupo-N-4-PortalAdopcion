meta {
  name: Update Estado
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/solicitudes/{{solicitudId}}/estado
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estado": "Aprobada"
  }
}

tests {
  const res = bru.getResBody();
  const status = res.getStatus();
  const body = res.getBody();

  test("Código de estado 200", () => {
    expect(status).to.equal(200);
  });

  test("La solicitud queda Aprobada", () => {
    expect(body).to.have.property("estado").that.equals("Aprobada");
  });
}